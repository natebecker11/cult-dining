// Firestore security rules for cultural-dinners-f837a.
// Edit here, not in the Firebase console, then deploy:
//   npx firebase-tools deploy --only firestore:rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Google sign-ins always have a verified email; this blocks unverified sign-in methods
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Allowlists: a document whose ID is the person's email
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/Admins/$(request.auth.token.email));
    }
    function isContributor() {
      return signedIn() && exists(/databases/$(database)/documents/Contributors/$(request.auth.token.email));
    }

    // The signed-in contributor created this journal entry
    function isOwner() {
      return isContributor() && resource.data.createdBy.uid == request.auth.uid;
    }

    // Shape every journal entry must have, new or edited (see src/app/models/country-entry.ts)
    function validEntryShape(d) {
      return d.type in ['photo', 'dish']
        && d.country is string && d.country.size() > 0
        && d.photos is list && d.photos.size() <= 20
        && ((d.type == 'photo' && d.photos.size() == 1)
         || (d.type == 'dish'
             && d.title is string && d.title.size() > 0 && d.title.size() <= 120
             && d.madeBy is string && d.madeBy.size() > 0 && d.madeBy.size() <= 80));
    }

    // A new entry must also name the person creating it
    function validNewEntry() {
      let d = request.resource.data;
      return validEntryShape(d)
        && d.createdBy.uid == request.auth.uid
        && d.createdBy.email == request.auth.token.email;
    }

    // A role grant made in Manage Users: records who granted it and when
    function validGrant(email) {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'grantedBy', 'grantedAt'])
        && d.email == email
        && d.grantedBy == request.auth.token.email
        && d.grantedAt == request.time;
    }

    // Allowlists: each person can check their own entry; admins see everyone (Manage Users).
    // Admins can make anyone an admin, but nobody can remove an admin from the app
    // (delete the doc in the Firebase console if you ever need to).
    match /Admins/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isAdmin());
      allow create: if isAdmin() && validGrant(email);
      allow update, delete: if false;
    }
    // Admins can add and remove contributors
    match /Contributors/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isAdmin());
      allow create: if isAdmin() && validGrant(email);
      allow delete: if isAdmin();
      allow update: if false;
    }

    // Everyone who has signed in (doc ID = their uid), so Manage Users can list them.
    // People write only their own doc, with their own uid and email; firstSeen never changes.
    function validUser(d) {
      return d.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'firstSeen', 'lastSeen'])
        && d.uid == request.auth.uid
        && d.email == request.auth.token.email
        && d.displayName is string && d.displayName.size() <= 200
        && d.photoURL is string && d.photoURL.size() <= 2000
        && d.lastSeen == request.time;
    }
    match /Users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && validUser(request.resource.data)
        && request.resource.data.firstSeen == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && validUser(request.resource.data)
        && request.resource.data.firstSeen == resource.data.firstSeen;
      allow delete: if false;
    }

    // Country lists: everyone reads (globe and wheel), only admins change them
    match /AllCountries/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /UsedCountries/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Gemini API key: the browser reads it for every visitor to generate the yearly summary.
    // Keep this key in a Google Cloud project without billing so it can only use the free tier.
    match /ApiKeys/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Dinner journal: everyone reads; contributors add; the creator or an admin edits and deletes
    match /CountryEntries/{entryId} {
      allow read: if true;
      allow create: if isContributor() && validNewEntry();
      allow update: if (isAdmin() || isOwner())
        && validEntryShape(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.country == resource.data.country
        && request.resource.data.type == resource.data.type;
      allow delete: if isAdmin() || isOwner();
    }

    // Anything not listed above is denied.
  }
}
